<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- AAA Launcher Palette -->
    <Color x:Key="PrimaryBackgroundColor">#FF0A0A0C</Color>
    <Color x:Key="SidebarBackgroundColor">#FF121214</Color>
    <Color x:Key="SecondaryBackgroundColor">#FF1C1C1F</Color>
    
    <Color x:Key="AccentColor">#FFC28B2D</Color> <!-- Gold-ish -->
    <Color x:Key="AccentHoverColor">#FFD49E3D</Color>
    
    <Color x:Key="PlayButtonColor">#FF00C8C8</Color> <!-- Teal/Cyan -->
    <Color x:Key="PlayButtonHoverColor">#FF00E6E6</Color>
    
    <Color x:Key="TextColor">#FFE0E0E0</Color>
    <Color x:Key="TextMutedColor">#FF9E9E9E</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    
    <SolidColorBrush x:Key="PlayButtonBrush" Color="{StaticResource PlayButtonColor}" />
    <SolidColorBrush x:Key="PlayButtonHoverBrush" Color="{StaticResource PlayButtonHoverColor}" />
    
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

</ResourceDictionary>
