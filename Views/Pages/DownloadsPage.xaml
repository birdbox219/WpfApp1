<UserControl x:Class="WpfApp1.Views.Pages.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="DOWNLOADS" Style="{StaticResource TitleText}" Margin="0,0,0,30" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Downloads}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SidebarBackgroundBrush}" Margin="0,0,0,15" Padding="20" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding FileName}" Style="{StaticResource SubtitleText}" Margin="0,0,0,10" />
                                    <Grid>
                                        <mah:MetroProgressBar Value="{Binding Progress}" Height="8" Foreground="{StaticResource AccentBrush}" Background="#1AFFFFFF" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource CaptionText}" Margin="0,0,20,0" />
                                        <TextBlock Text="{Binding Speed}" Style="{StaticResource CaptionText}" />
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:F1}%}" 
                                           Style="{StaticResource SubtitleText}" VerticalAlignment="Center" Margin="20,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
