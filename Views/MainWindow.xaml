<mah:MetroWindow x:Class="WpfApp1.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:WpfApp1.ViewModels"
        xmlns:pages="clr-namespace:WpfApp1.Views.Pages"
        mc:Ignorable="d"
        Title="Game Launcher" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        FlowDirection="{DynamicResource AppFlowDirection}"
        Background="{StaticResource PrimaryBackgroundBrush}"
        GlowBrush="{StaticResource AccentBrush}"
        WindowTitleBrush="{StaticResource SidebarBackgroundBrush}"
        NonActiveWindowTitleBrush="{StaticResource SidebarBackgroundBrush}"
        TitleCharacterCasing="Normal"
        ShowTitleBar="True"
        ShowIconOnTitleBar="True"
        BorderThickness="1"
        BorderBrush="{StaticResource AccentBrush}">

    <Window.Resources>
        <!-- Page Mapping -->
        <DataTemplate DataType="{x:Type viewmodels:HomeViewModel}">
            <pages:HomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:NewsViewModel}">
            <pages:NewsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:DownloadsViewModel}">
            <pages:DownloadsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <pages:SettingsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InstalledGamesViewModel}">
            <pages:LibraryPage />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" BorderBrush="#1AFFFFFF" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Logo/Title -->
                <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="CodeArts" FontSize="28" FontWeight="ExtraBold" Foreground="{DynamicResource MahApps.Brushes.Button.CleanWindow.Close.Background.MouseOver}" />
                    <TextBlock Text="LAUNCHER" FontSize="12" FontWeight="Bold" Foreground="White" Margin="2, -5, 0, 0" />
                </StackPanel>

                <!-- Navigation Menu -->
                <ListBox Grid.Row="1" Margin="0,20" 
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <DockPanel LastChildFill="False" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource SidebarItemStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBottom}" Value="True">
                                    <Setter Property="DockPanel.Dock" Value="Bottom" />
                                    <!-- Push settings to the bottom using a margin -->
                                    <Setter Property="Margin" Value="0,20,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsBottom}" Value="False">
                                    <Setter Property="DockPanel.Dock" Value="Top" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding IconKind}" VerticalAlignment="Center" Margin="0,0,15,0" Width="20" Height="20" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="15" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1">
            <!-- Background Decoration -->
            <Ellipse Fill="{StaticResource AccentBrush}" Width="600" Height="600" Opacity="0.05" Margin="-300,-300,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <BlurEffect Radius="100" />
                </Ellipse.Effect>
            </Ellipse>

            <!-- Active Page Content -->
            <ContentControl Content="{Binding CurrentViewModel}" Margin="0" />
        </Grid>
    </Grid>
</mah:MetroWindow>
