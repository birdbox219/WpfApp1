## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][⡙]In32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bbin/
obj/
external/
[Log]s/
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Visual Studio 2015/2017/2019/2022 cache and settings
.vs/
# Uncomment if you use a custom Visual Studio cache directory
# .vs_cache/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Windows image caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on separate drives
$RECYCLE.BIN/

# VS Code folders and files
.vscode/
.history/
*.code-workspace

# .NET Core / .NET 5+ temporary files
project.lock.json
project.fragment.lock.json
artifacts/

# AspNet5 system files
Microsoft.DotNet.Props
Microsoft.DotNet.targets

# StyleCop
StyleCop.Cache

# JetBrains Resharper
_ReSharper*/
*.[Rr]e[Ss]harper.user

# JustMock
*.jmconfig

# TeamCity
_TeamCity*

# DotCover
*.dotCover

# AxoCover
.axoCover/*

# Coverlet
coverage.json
coverage.cobertura.xml
coverage.info

# Visual Studio code coverage
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass/less/coffeescript)
.sass-cache/

# Installshield output folder
[Ee]xpress/

# DocProject is a documentation generator for Visual Studio
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# ClickOnce directory
publish/

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml
# TODO: Comment the next line if you want to checkin your web deploy settings
# but database connection strings (with password) might create security issues
*.pubxml
*.publishproj

# Microsoft Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Emulator
ecf/
rcf/

# Windows Azure packaging tool
*.azurePubxml

# Others
sql/
*.Cache
ClientBin/
[Ss]tyle[Cc]ope.Cache
~$*
*~
*.dbmdl
*.dbproj.user
*.publishsettings
node_modules/
npm-debug.log
bower_components/

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet repositories to supply packages:
# ![Pp]ackages/build/
# ![Pp]ackages/Newtonsoft.Json.12.0.1/build/
# !packages/build/
# !packages/Newtonsoft.Json.12.0.1/build/

# Microsoft Office temporary files
~$*

# GhostDoc
*.GhostDoc.xml

# AppInsights config file
ApplicationInsights.config

# Bower
.bowerrc
bower_components

# gulp/grunt
_gulp_output/
_grunt_output/

# VS Code
.vscode

# Node.js
node_modules/

# Local history
.history/

# Local log files
*.log
crash.log

# Gemini/AI specific
.gemini/
.agents/
.ai/

# Rider
.idea/
*.sln.iml
